@page
@model FamilyDispatch.Web.Pages.Account.LoginModel
@using FamilyDispatch.Web.Data
@{
    ViewData["Title"] = "Sign in";
}

<div class="row g-4">
    <div class="col-md-5">
        <h1 class="h3">Sign in</h1>
        @if (Model.Error is not null)
        {
            <div class="alert alert-danger" role="alert">@Model.Error</div>
        }
        <form method="post" id="login-form" data-demo-password="@SeedData.DemoPassword">
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" type="email" class="form-control" autocomplete="username" placeholder="owner@alpha.example" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Sign in</button>
        </form>
    </div>

    <div class="col-md-7">
        <div class="card">
            <div class="card-body">
                <h2 class="h5">Demo accounts (fake, for review only)</h2>
                <p class="mb-2">Password for all: <code>@SeedData.DemoPassword</code></p>
                <div class="table-responsive">
                    <table class="table table-striped table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Company</th>
                                <th scope="col">Name</th>
                                <th scope="col">Role</th>
                                <th scope="col">Email</th>
                                <th scope="col"><span class="visually-hidden">Action</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in SeedData.DemoUsers)
                            {
                                <tr>
                                    <td>@u.Company</td>
                                    <td>@u.Name</td>
                                    <td>@u.Role</td>
                                    <td>@u.Email</td>
                                    <td><button type="button" class="btn btn-sm btn-outline-primary" data-email="@u.Email">Sign in as</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="alert alert-info mt-3 mb-0">
            <strong>Security check:</strong> sign in as owner@alpha.example, then open <code>/Loads/4</code>
            (BET-2001, a Beta Logistics load). You get 404 Not found in your company.
            Try <code>/Trucks/Create</code> as dispatch@alpha.example for 403.
        </div>
    </div>
</div>
