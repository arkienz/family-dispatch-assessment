@page "/Loads/{id:int}"
@model FamilyDispatch.Web.Pages.Loads.DetailsModel
@using FamilyDispatch.Web.Domain
@{
    var l = Model.Load;
    ViewData["Title"] = l.ReferenceNo;
    var current = Array.IndexOf(LoadWorkflow.Steps, l.Status);
}

<div class="d-flex flex-wrap gap-2 align-items-start justify-content-between mb-3">
    <div>
        <h1 class="h3 mb-0">@l.ReferenceNo <span class="@Ui.StatusBadgeClass(l.Status) fs-6 align-middle">@Ui.StatusLabel(l.Status)</span></h1>
        <div class="text-body-secondary">Load #@l.Id</div>
    </div>
    <div class="d-flex flex-wrap gap-2 align-items-center">
        @if (LoadWorkflow.CanReassign(l.Status) && !User.IsInRole(nameof(Role.Driver)))
        {
            <a asp-page="/Loads/Assign" asp-route-id="@l.Id" class="btn btn-outline-secondary">Change driver/truck</a>
        }
        <a asp-page="/Loads/Index">Back to loads</a>
    </div>
</div>

<dl class="row">
    <dt class="col-sm-3">Route</dt><dd class="col-sm-9">@l.Origin &rarr; @l.Destination</dd>
    <dt class="col-sm-3">Pickup</dt><dd class="col-sm-9">@Ui.Utc(l.PickupDateUtc)</dd>
    <dt class="col-sm-3">Driver</dt><dd class="col-sm-9">@l.Driver.DisplayName</dd>
    <dt class="col-sm-3">Truck</dt><dd class="col-sm-9">@(l.Truck is null ? "None" : $"{l.Truck.UnitNumber} ({l.Truck.Plate})")</dd>
    <dt class="col-sm-3">Created</dt><dd class="col-sm-9">@Ui.Utc(l.CreatedAtUtc)</dd>
    <dt class="col-sm-3">Picked up</dt><dd class="col-sm-9">@Ui.Utc(l.PickedUpAtUtc)</dd>
    <dt class="col-sm-3">Delivered</dt><dd class="col-sm-9">@Ui.Utc(l.DeliveredAtUtc)</dd>
</dl>

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h5">Status</h2>
        <ol class="stepper mb-0" aria-label="Load status">
            @for (var i = 0; i < LoadWorkflow.Steps.Length; i++)
            {
                var s = LoadWorkflow.Steps[i];
                if (i < current)
                {
                    <li class="done">@Ui.StatusLabel(s)<span class="visually-hidden"> (done)</span></li>
                }
                else if (i == current)
                {
                    <li aria-current="step">@Ui.StatusLabel(s)</li>
                }
                else
                {
                    <li>@Ui.StatusLabel(s)</li>
                }
            }
        </ol>
        @if (LoadWorkflow.Next(l.Status) is { } next)
        {
            <form method="post" asp-page-handler="Status" asp-route-id="@l.Id" class="row mt-3">
                <input type="hidden" name="target" value="@next" />
                @* The status this page showed: if someone moved the load since, the server answers 409. *@
                <input type="hidden" name="from" value="@l.Status" />
                <div class="col-12 col-sm-auto">
                    <button type="submit" class="btn btn-primary btn-lg w-100">Mark as @Ui.StatusLabel(next)</button>
                </div>
                @if (next == LoadStatus.Delivered)
                {
                    <div class="col-12 form-text">Delivered is final. It can't be moved back.</div>
                }
            </form>
        }
        else
        {
            <p class="mt-3 mb-0">Delivered @Ui.Utc(l.DeliveredAtUtc). No further steps.</p>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h2 class="h5">Documents</h2>
        <form method="post" enctype="multipart/form-data" asp-page-handler="Upload" asp-route-id="@l.Id" class="mb-3" id="upload-form"
              data-max-bytes="@FamilyDispatch.Web.Services.DocumentStorage.MaxBytes">
            <label for="file" class="form-label">Delivery document</label>
            <div class="d-flex flex-wrap gap-2">
                <input type="file" id="file" name="file" accept=".pdf,.jpg,.jpeg,.png" class="form-control w-auto flex-grow-1" aria-describedby="file-help" />
                <button type="submit" class="btn btn-outline-primary">Upload</button>
            </div>
            <div id="file-help" class="form-text">PDF, JPG or PNG, up to 5 MB. Signed delivery receipt (POD) or a photo of it.</div>
            <div id="file-too-big" class="alert alert-danger mt-2 mb-0" role="alert" hidden>File is larger than 5 MB.</div>
        </form>

        @if (l.Documents.Count == 0)
        {
            <p class="mb-0">No documents yet. Upload the signed delivery receipt here.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">File</th>
                            <th scope="col">Size</th>
                            <th scope="col" class="d-none d-md-table-cell">Uploaded by</th>
                            <th scope="col" class="d-none d-md-table-cell">Uploaded</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in l.Documents.OrderByDescending(d => d.UploadedAtUtc))
                        {
                            <tr>
                                <td><a href="/Loads/@l.Id/Documents/@d.Id">@d.OriginalFileName</a></td>
                                <td class="text-nowrap">@Ui.FileSize(d.SizeBytes)</td>
                                <td class="d-none d-md-table-cell">@d.UploadedBy.DisplayName</td>
                                <td class="d-none d-md-table-cell text-nowrap">@Ui.Utc(d.UploadedAtUtc)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
